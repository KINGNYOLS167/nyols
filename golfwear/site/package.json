{
  "name": "golfwear-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GOLFWEAR website: browse here, buy on Tokopedia. Private admin for sales, expenses and stock.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:api": "node scripts/test-api.mjs",
    "assets": "node scripts/render-assets.mjs && python3 scripts/bake_ball.py",
    "serve:local": "node scripts/serve-local.mjs"
  },
  "dependencies": {
    "@fontsource/jost": "5.3.0",
    "@gsap/react": "2.1.2",
    "@neondatabase/serverless": "^1.2.1",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
